{
  "name": "esp32-drone",
  "private": true,
  "version": "0.1.0",
  "description": "ESP32 drone ground control station: React UI + Python bridge + PlatformIO firmware",
  "workspaces": ["apps/web"],
  "scripts": {
    "dev": "concurrently -n web,bridge -c cyan,yellow \"npm:dev:web\" \"npm:dev:bridge\"",
    "dev:sim": "concurrently -n web,bridge -c cyan,yellow \"npm:dev:web\" \"npm:dev:bridge:sim\"",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:bridge": "python -u apps/bridge/server.py",
    "dev:bridge:sim": "python -u apps/bridge/server.py --sim",
    "build": "npm run build --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "python -m pytest apps/bridge/tests -q",
    "setup:bridge": "python -m pip install -r apps/bridge/requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
